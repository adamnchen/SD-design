<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.sutran.sd.design.mapper.SdCrowdfundingSampleDeliveryMapper">

    <resultMap type="com.sutran.sd.design.domain.SdCrowdfundingSampleDelivery" id="SdCrowdfundingSampleDeliveryResult">
        <result property="id" column="id"/>
        <result property="crowdfundingProjectId" column="crowdfunding_project_id"/>
        <result property="proofingInvitationId" column="proofing_invitation_id"/>
        <result property="sampleImageUrl" column="sample_image_url"/>
        <result property="recipientUserId" column="recipient_user_id"/>
        <result property="recipientName" column="recipient_name"/>
        <result property="recipientPhone" column="recipient_phone"/>
        <result property="deliveryAddress" column="delivery_address"/>
        <result property="trackingNumber" column="tracking_number"/>
        <result property="deliveryCompany" column="delivery_company"/>
        <result property="status" column="delivery_status"/>
        <result property="remark" column="remark"/>
        <result property="senderUserId" column="sender_user_id"/>
        <result property="senderName" column="sender_name"/>
        <result property="deliveryTime" column="delivery_time"/>
        <result property="confirmTime" column="confirm_time"/>
        <result property="createBy" column="create_by"/>
        <result property="createTime" column="create_time"/>
        <result property="updateBy" column="update_by"/>
        <result property="updateTime" column="update_time"/>
        <result property="orderStatus" column="order_status"/>
        <result property="quantity" column="quantity"/>
    </resultMap>

    <sql id="selectSdCrowdfundingSampleDeliveryVo">
        select id, crowdfunding_project_id, proofing_invitation_id, sample_image_url,
               recipient_user_id, recipient_name, recipient_phone, delivery_address,
               tracking_number, delivery_company, delivery_status, remark, sender_user_id, sender_name,
               delivery_time, confirm_time, create_by, create_time, update_by, update_time, order_status, quantity
        from sd_crowdfunding_sample_delivery
    </sql>

    <select id="selectSdCrowdfundingSampleDeliveryById" parameterType="Long" resultMap="SdCrowdfundingSampleDeliveryResult">
        <include refid="selectSdCrowdfundingSampleDeliveryVo"/>
        where id = #{id}
    </select>

    <select id="selectSdCrowdfundingSampleDeliveryList" parameterType="com.sutran.sd.design.domain.SdCrowdfundingSampleDelivery" resultMap="SdCrowdfundingSampleDeliveryResult">
        <include refid="selectSdCrowdfundingSampleDeliveryVo"/>
        <where>
            <if test="crowdfundingProjectId != null">
                AND crowdfunding_project_id = #{crowdfundingProjectId}
            </if>
            <if test="proofingInvitationId != null">
                AND proofing_invitation_id = #{proofingInvitationId}
            </if>
            <if test="recipientUserId != null">
                AND recipient_user_id = #{recipientUserId}
            </if>
            <if test="senderUserId != null">
                AND sender_user_id = #{senderUserId}
            </if>
            <if test="status != null">
                AND delivery_status = #{status}
            </if>
            <if test="trackingNumber != null and trackingNumber != ''">
                AND tracking_number = #{trackingNumber}
            </if>
        </where>
        order by create_time desc
    </select>

    <select id="selectByProjectId" parameterType="Long" resultMap="SdCrowdfundingSampleDeliveryResult">
        <include refid="selectSdCrowdfundingSampleDeliveryVo"/>
        where crowdfunding_project_id = #{projectId}
        order by create_time desc
    </select>

    <select id="selectByRecipientUserId" parameterType="Long" resultMap="SdCrowdfundingSampleDeliveryResult">
        <include refid="selectSdCrowdfundingSampleDeliveryVo"/>
        where recipient_user_id = #{recipientUserId}
        order by create_time desc
    </select>

    <select id="selectBySenderUserId" parameterType="Long" resultMap="SdCrowdfundingSampleDeliveryResult">
        <include refid="selectSdCrowdfundingSampleDeliveryVo"/>
        where sender_user_id = #{senderUserId}
        order by create_time desc
    </select>

</mapper>
