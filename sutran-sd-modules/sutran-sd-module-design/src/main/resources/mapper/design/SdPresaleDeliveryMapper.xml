    <delete id="deleteSdPresaleDeliveryByIds">
        delete from sd_presale_delivery
        where id in
        <foreach collection="array" item="id" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>

    <select id="selectByDeliveryNo" parameterType="String" resultMap="SdPresaleDeliveryResult">
        <include refid="selectSdPresaleDeliveryVo"/>
        where delivery_no = #{deliveryNo}
    </select>

    <select id="selectByOrderNo" parameterType="String" resultMap="SdPresaleDeliveryResult">
        <include refid="selectSdPresaleDeliveryVo"/>
        where order_no = #{orderNo}
        order by create_time desc
    </select>

    <select id="selectProjectDeliveryList" resultMap="PresaleDeliveryListVOResult">
        select d.id, d.delivery_no, d.project_id, p.title as project_title, d.order_id, d.order_no, 
               d.user_id, d.user_name, d.product_title, d.quantity, d.total_amount,
               d.recipient_name, d.recipient_phone, d.recipient_address, d.tracking_number, d.delivery_status,
               case d.delivery_status 
                   when 1 then '待发货'
                   when 2 then '已发货'
                   else '未知状态'
               end as delivery_status_text,
               d.delivery_time, d.sender_user_id, d.create_time, d.update_time
        from sd_presale_delivery d
        left join sd_presale_project p on d.project_id = p.id
        where d.project_id = #{projectId}
        order by d.create_time desc
    </select>

    <select id="selectUserDeliveryList" resultMap="PresaleDeliveryListVOResult">
        select d.id, d.delivery_no, d.project_id, p.title as project_title, d.order_id, d.order_no, 
               d.user_id, d.user_name, d.product_title, d.quantity, d.total_amount,
               d.recipient_name, d.recipient_phone, d.recipient_address, d.tracking_number, d.delivery_status,
               case d.delivery_status 
