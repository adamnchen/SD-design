    <sql id="selectSdPresaleDeliveryVo">
        select id, delivery_no, project_id, order_id, order_no, user_id, user_name, product_title, 
               quantity, total_amount, recipient_name, recipient_phone, recipient_address, 
               tracking_number, delivery_status, delivery_time, sender_user_id, 
               create_by, create_time, update_by, update_time 
        from sd_presale_delivery
    </sql>

    <select id="selectSdPresaleDeliveryById" parameterType="Long" resultMap="SdPresaleDeliveryResult">
        <include refid="selectSdPresaleDeliveryVo"/>
        where id = #{id}
    </select>

    <select id="selectSdPresaleDeliveryList" parameterType="com.sutran.sd.design.domain.SdPresaleDelivery" resultMap="SdPresaleDeliveryResult">
        <include refid="selectSdPresaleDeliveryVo"/>
        <where>  
            <if test="deliveryNo != null  and deliveryNo != ''"> and delivery_no = #{deliveryNo}</if>
            <if test="projectId != null "> and project_id = #{projectId}</if>
            <if test="orderId != null "> and order_id = #{orderId}</if>
            <if test="orderNo != null  and orderNo != ''"> and order_no = #{orderNo}</if>
            <if test="userId != null "> and user_id = #{userId}</if>
            <if test="userName != null  and userName != ''"> and user_name like concat('%', #{userName}, '%')</if>
            <if test="productTitle != null  and productTitle != ''"> and product_title like concat('%', #{productTitle}, '%')</if>
            <if test="recipientName != null  and recipientName != ''"> and recipient_name like concat('%', #{recipientName}, '%')</if>
            <if test="recipientPhone != null  and recipientPhone != ''"> and recipient_phone = #{recipientPhone}</if>
            <if test="trackingNumber != null  and trackingNumber != ''"> and tracking_number = #{trackingNumber}</if>
            <if test="deliveryStatus != null "> and delivery_status = #{deliveryStatus}</if>
            <if test="senderUserId != null "> and sender_user_id = #{senderUserId}</if>
        </where>
        order by create_time desc
    </select>

