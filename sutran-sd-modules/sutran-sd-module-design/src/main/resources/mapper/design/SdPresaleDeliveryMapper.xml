                   else '未知状态'
               end as delivery_status_text,
               d.delivery_time, d.sender_user_id, d.create_time, d.update_time
        from sd_presale_delivery d
        left join sd_presale_project p on d.project_id = p.id
        where d.user_id = #{userId}
        order by d.create_time desc
    </select>

    <select id="selectSenderDeliveryList" resultMap="PresaleDeliveryListVOResult">
        select d.id, d.delivery_no, d.project_id, p.title as project_title, d.order_id, d.order_no, 
               d.user_id, d.user_name, d.product_title, d.quantity, d.total_amount,
               d.recipient_name, d.recipient_phone, d.recipient_address, d.tracking_number, d.delivery_status,
               case d.delivery_status 
