<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.sutran.sd.design.mapper.DesignSdUserModelFileMapper">

    <resultMap type="com.sutran.sd.design.domain.DesignSdUserModelFile" id="SdUserModelFileResult">
        <result property="id"    column="id"    />
        <result property="taskId"    column="task_id"    />
        <result property="category"    column="category"    />
        <result property="isRedraw"    column="is_redraw"    />
        <result property="prompt"    column="prompt"    />
        <result property="promptZh"    column="prompt_zh"    />
        <result property="promptDesc"    column="prompt_desc"    />
        <result property="negativePrompt"    column="negative_prompt"    />
        <result property="negativePromptZh"    column="negative_prompt_zh"    />
        <result property="modelStrength"    column="model_strength"    />
        <result property="initImg"    column="init_img"    />
        <result property="fileUrl"    column="file_url"    />
        <result property="fileInfo"    column="file_info"    />
        <result property="fileParameters"    column="file_parameters"    />
        <result property="modelName"    column="model_name"    />
        <result property="loraModelId"    column="lora_model_id"    />
        <result property="loraTitle"    column="lora_title"    />
        <result property="loraTitleZh"    column="lora_title_zh"    />
        <result property="loraInfo"    column="lora_info"    />
        <result property="belongUserId"    column="belong_user_id"    />
        <result property="belongUserName"    column="belong_user_name"    />
        <result property="crtTime"    column="crt_time"    />
    </resultMap>

    <sql id="selectSdUserModelFileVo">
        select id, task_id, category, is_redraw, prompt, prompt_zh, prompt_desc, negative_prompt, negative_prompt_zh, model_strength, init_img, file_url, file_info, file_parameters, model_name, lora_model_id, lora_title, lora_title_zh, lora_info, belong_user_id, belong_user_name, crt_time from sd_user_model_file
    </sql>

    <select id="selectSdUserModelFileList" parameterType="com.sutran.sd.design.domain.DesignSdUserModelFile" resultMap="SdUserModelFileResult">
        <include refid="selectSdUserModelFileVo"/>
        <where>
            <if test="taskId != null "> and task_id = #{taskId}</if>
            <if test="category != null "> and category = #{category}</if>
            <if test="isRedraw != null "> and is_redraw = #{isRedraw}</if>
            <if test="prompt != null  and prompt != ''"> and prompt like concat('%', #{prompt}, '%')</if>
            <if test="promptZh != null  and promptZh != ''"> and prompt_zh like concat('%', #{promptZh}, '%')</if>
            <if test="promptDesc != null  and promptDesc != ''"> and prompt_desc like concat('%', #{promptDesc}, '%')</if>
            <if test="negativePrompt != null  and negativePrompt != ''"> and negative_prompt like concat('%', #{negativePrompt}, '%')</if>
            <if test="negativePromptZh != null  and negativePromptZh != ''"> and negative_prompt_zh like concat('%', #{negativePromptZh}, '%')</if>
            <if test="modelStrength != null  and modelStrength != ''"> and model_strength = #{modelStrength}</if>
            <if test="initImg != null  and initImg != ''"> and init_img = #{initImg}</if>
            <if test="fileUrl != null  and fileUrl != ''"> and file_url = #{fileUrl}</if>
            <if test="fileInfo != null  and fileInfo != ''"> and file_info = #{fileInfo}</if>
            <if test="fileParameters != null  and fileParameters != ''"> and file_parameters = #{fileParameters}</if>
            <if test="modelName != null  and modelName != ''"> and model_name like concat('%', #{modelName}, '%')</if>
            <if test="loraModelId != null "> and lora_model_id = #{loraModelId}</if>
            <if test="loraTitle != null  and loraTitle != ''"> and lora_title like concat('%', #{loraTitle}, '%')</if>
            <if test="loraTitleZh != null  and loraTitleZh != ''"> and lora_title_zh like concat('%', #{loraTitleZh}, '%')</if>
            <if test="loraInfo != null  and loraInfo != ''"> and lora_info = #{loraInfo}</if>
            <if test="belongUserId != null "> and belong_user_id = #{belongUserId}</if>
            <if test="belongUserName != null  and belongUserName != ''"> and belong_user_name like concat('%', #{belongUserName}, '%')</if>
            <if test="crtTime != null "> and crt_time = #{crtTime}</if>
        </where>
        order by crt_time desc
    </select>

    <select id="selectSdUserModelFileById" parameterType="Long" resultMap="SdUserModelFileResult">
        <include refid="selectSdUserModelFileVo"/>
        where id = #{id}
    </select>

    <select id="selectSdUserModelFileListByUserId" parameterType="Long" resultMap="SdUserModelFileResult">
        <include refid="selectSdUserModelFileVo"/>
        where belong_user_id = #{userId}
        order by crt_time desc
    </select>

    <select id="selectSdUserModelFileListByUserIdAndCategory" resultMap="SdUserModelFileResult">
        <include refid="selectSdUserModelFileVo"/>
        where belong_user_id = #{userId}
        <if test="category != null">
            and category = #{category}
        </if>
        order by crt_time desc
    </select>

    <insert id="insertSdUserModelFile" parameterType="com.sutran.sd.design.domain.DesignSdUserModelFile" useGeneratedKeys="true" keyProperty="id">
        insert into sd_user_model_file
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="taskId != null">task_id,</if>
            <if test="category != null">category,</if>
            <if test="isRedraw != null">is_redraw,</if>
            <if test="prompt != null and prompt != ''">prompt,</if>
            <if test="promptZh != null and promptZh != ''">prompt_zh,</if>
            <if test="promptDesc != null and promptDesc != ''">prompt_desc,</if>
            <if test="negativePrompt != null and negativePrompt != ''">negative_prompt,</if>
            <if test="negativePromptZh != null and negativePromptZh != ''">negative_prompt_zh,</if>
            <if test="modelStrength != null and modelStrength != ''">model_strength,</if>
            <if test="initImg != null and initImg != ''">init_img,</if>
            <if test="fileUrl != null and fileUrl != ''">file_url,</if>
            <if test="fileInfo != null and fileInfo != ''">file_info,</if>
            <if test="fileParameters != null and fileParameters != ''">file_parameters,</if>
            <if test="modelName != null and modelName != ''">model_name,</if>
            <if test="loraModelId != null">lora_model_id,</if>
            <if test="loraTitle != null and loraTitle != ''">lora_title,</if>
            <if test="loraTitleZh != null and loraTitleZh != ''">lora_title_zh,</if>
            <if test="loraInfo != null and loraInfo != ''">lora_info,</if>
            <if test="belongUserId != null">belong_user_id,</if>
            <if test="belongUserName != null and belongUserName != ''">belong_user_name,</if>
            <if test="crtTime != null">crt_time,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="taskId != null">#{taskId},</if>
            <if test="category != null">#{category},</if>
            <if test="isRedraw != null">#{isRedraw},</if>
            <if test="prompt != null and prompt != ''">#{prompt},</if>
            <if test="promptZh != null and promptZh != ''">#{promptZh},</if>
            <if test="promptDesc != null and promptDesc != ''">#{promptDesc},</if>
            <if test="negativePrompt != null and negativePrompt != ''">#{negativePrompt},</if>
            <if test="negativePromptZh != null and negativePromptZh != ''">#{negativePromptZh},</if>
            <if test="modelStrength != null and modelStrength != ''">#{modelStrength},</if>
            <if test="initImg != null and initImg != ''">#{initImg},</if>
            <if test="fileUrl != null and fileUrl != ''">#{fileUrl},</if>
            <if test="fileInfo != null and fileInfo != ''">#{fileInfo},</if>
            <if test="fileParameters != null and fileParameters != ''">#{fileParameters},</if>
            <if test="modelName != null and modelName != ''">#{modelName},</if>
            <if test="loraModelId != null">#{loraModelId},</if>
            <if test="loraTitle != null and loraTitle != ''">#{loraTitle},</if>
            <if test="loraTitleZh != null and loraTitleZh != ''">#{loraTitleZh},</if>
            <if test="loraInfo != null and loraInfo != ''">#{loraInfo},</if>
            <if test="belongUserId != null">#{belongUserId},</if>
            <if test="belongUserName != null and belongUserName != ''">#{belongUserName},</if>
            <if test="crtTime != null">#{crtTime},</if>
         </trim>
    </insert>


    <delete id="deleteSdUserModelFileById" parameterType="Long">
        delete from sd_user_model_file where id = #{id}
    </delete>

    <delete id="deleteSdUserModelFileByIds" parameterType="String">
        delete from sd_user_model_file where id in
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>
</mapper>
